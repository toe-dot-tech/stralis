# ---------------------------------------------------------------------------
# Stralis configuration (mirrors stralis/config.py).
#
# Every STRALIS_* variable Stralis reads is listed here with its default.
# docker-compose.yml hard-codes the same values inline for the in-cluster
# service DNS names; use this file for local, non-Docker runs and as
# reference. Copy to `.env` and edit as needed.
# ---------------------------------------------------------------------------

# --- Persistence -----------------------------------------------------------
# Postgres (production / docker-compose):
STRALIS_DATABASE_URL=postgresql+psycopg://stralis:stralis@localhost:5432/stralis
# SQLite (local quickstart -- zero external services):
#STRALIS_DATABASE_URL=sqlite:///./stralis.db

# --- Backends --------------------------------------------------------------
# redis (Streams) | sqlite (in-tree, zero-services)
STRALIS_QUEUE_BACKEND=redis
# s3 (S3/MinIO) | local (filesystem)
STRALIS_STORE_BACKEND=s3
# Root directory used when STRALIS_STORE_BACKEND=local
STRALIS_LOCAL_STORE_ROOT=./.stralis-store

# --- Queue (Redis Streams) -------------------------------------------------
# Only used when STRALIS_QUEUE_BACKEND=redis.
STRALIS_REDIS_URL=redis://localhost:6379/0
STRALIS_QUEUE_GROUP=stralis-workers

# --- Object store (S3-compatible, e.g. MinIO) ------------------------------
# Leave empty to use AWS S3 via boto3's default credential chain.
STRALIS_S3_ENDPOINT_URL=http://localhost:9000
# Local AWS S3 (no endpoint):
#STRALIS_S3_ENDPOINT_URL=
STRALIS_S3_BUCKET=stralis
STRALIS_S3_ACCESS_KEY=minio
STRALIS_S3_SECRET_KEY=minio123
STRALIS_S3_REGION=us-east-1

# --- Execution / resilience -----------------------------------------------
# Seconds between worker heartbeats while a node is RUNNING.
STRALIS_HEARTBEAT_INTERVAL_S=5.0
# A RUNNING node whose heartbeat is older than this is presumed dead and requeued.
STRALIS_HEARTBEAT_TIMEOUT_S=60.0
# Orchestrator sweep cadence: promote ready nodes / enqueue / recover stragglers.
STRALIS_SWEEP_INTERVAL_S=1.0
# Default per-node retry budget (override per-pipeline with spec.max_attempts).
STRALIS_MAX_ATTEMPTS=3

# --- Worker scratch space --------------------------------------------------
# Claim-check downloads land here before a handler runs.
STRALIS_WORK_ROOT=./.stralis-work

# --- Misc ------------------------------------------------------------------
STRALIS_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API ("*" = any). Required
# for the Flutter web UI, which runs on a different origin than the API.
STRALIS_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Zero-services quickstart (SQLite queue + local object store, no
# Postgres/Redis/MinIO) -- the whole stack runs on one machine:
#   STRALIS_DATABASE_URL=sqlite:///./.demo/stralis.db
#   STRALIS_QUEUE_BACKEND=sqlite
#   STRALIS_STORE_BACKEND=local
#   STRALIS_LOCAL_STORE_ROOT=./.demo/objects
#   STRALIS_WORK_ROOT=./.demo/work
# Then run: uvicorn stralis.api.app:app, `python -m stralis orchestrator`,
# `python -m stralis worker`, and the Flutter UI (ui_flutter/).
# ---------------------------------------------------------------------------
