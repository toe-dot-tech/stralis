{
  "name": "video-transcode",
  "max_attempts": 2,
  "metadata": {
    "description": "Self-contained ffmpeg pipeline driven by the lavfi testsrc source (no external media files). Requires ffmpeg + ffprobe in the worker image - see README 'Media toolkit layer'.",
    "requires": ["ffmpeg", "ffprobe"]
  },
  "nodes": [
    {
      "id": "generate",
      "name": "Generate test clip",
      "handler": "shell",
      "params": {
        "command": [
          "ffmpeg", "-y",
          "-f", "lavfi",
          "-i", "testsrc=duration=2:size=1280x720:rate=30",
          "-c:v", "libx264",
          "-pix_fmt", "yuv420p",
          "{output:mp4}"
        ],
        "outputs": ["mp4"],
        "timeout": 120
      }
    },
    {
      "id": "transcode",
      "name": "Downscale to 640x360",
      "handler": "ffmpeg.transcode",
      "params": {
        "input": "mp4",
        "output": "lowres.mp4",
        "args": ["-vf", "scale=640:360", "-c:v", "libx264", "-preset", "veryfast", "-c:a", "aac"],
        "timeout": 600
      },
      "depends_on": ["generate"]
    },
    {
      "id": "probe",
      "name": "Probe streams",
      "handler": "shell",
      "params": {
        "command": [
          "python",
          "-c",
          "import subprocess, sys; out = subprocess.run(['ffprobe', '-v', 'quiet', '-print_format', 'json', '-show_streams', sys.argv[1]], capture_output=True, text=True, check=True).stdout; open(sys.argv[2], 'w', encoding='utf-8').write(out)",
          "{input:lowres.mp4}",
          "{output:json}"
        ],
        "outputs": ["json"],
        "timeout": 60
      },
      "depends_on": ["transcode"]
    }
  ]
}
